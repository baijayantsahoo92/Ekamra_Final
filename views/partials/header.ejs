<header class="site-header">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Ekamra Medical Concierge home">
      <img src="/assets/img/Final_NoBG.png" alt="Ekamra Medical Concierge" width="190" height="86">
    </a>
    <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
      <span class="sr-only">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
      <% navItems.forEach((item) => { %>
        <a class="<%= currentPath === item.href ? 'active' : '' %>" href="<%= item.href %>"><%= item.label %></a>
      <% }) %>
    </nav>
  </div>
</header>
